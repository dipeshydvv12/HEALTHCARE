# ==============================================================================
# EnsureCare Follow-Up Coordination Platform - Environment Configuration Template
# Copy this file to .env and fill in your real credentials
# ==============================================================================

# 1. Google Gemini AI API Key (Clinical Symptom Analysis & Medication Support)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Twilio Voice API Credentials (for Real AI PSTN Outbound Phone Calls)
# Get your Account SID, Auth Token & Phone Number from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 3. Twilio AI Voice Synthesis Options
# Voice options: Polly.Aditi (Indian English), Polly.Raveena (Hindi/English), Polly.Joanna (US), alice
TWILIO_VOICE_NAME=Polly.Aditi
TWILIO_VOICE_LANGUAGE=en-IN

